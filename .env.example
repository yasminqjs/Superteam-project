# Copy this file to .env.local. Never commit .env.local.

# --- Mode -------------------------------------------------------------------
# mock: runs with ZERO setup. A fake in-memory Solana node, a built-in demo
#       wallet, a local JSON file as database and synthetic exchange rates.
#       Nothing is onchain. For development and rehearsal.
# live: Solana devnet, Phantom, Supabase and the Central Bank's PTAX API.
#       Needs everything below filled in.
# You can also pick the mode per run: `npm run dev:mock` / `npm run dev:live`.
# On Vercel, leaving this variable out means mock: a public sandbox with no
# setup. Set it to live there, with everything below, for the real thing.
NEXT_PUBLIC_RECEBI_MODE=mock

# Mock mode only, and normally left alone: where the mock world is kept.
# "local" (this machine's memory and .mock-data/) or "cookie" (the visitor's
# cookies, which is what a serverless host needs and what Vercel gets by itself).
# RECEBI_MOCK_STATE=cookie

# --- Live mode only ---------------------------------------------------------
# Recebi only runs on devnet. Any other value makes the app refuse to start.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Devnet RPC URL with an API key (e.g. Helius). Leave empty to use the public
# fallback https://api.devnet.solana.com, which rate-limits quickly.
NEXT_PUBLIC_RPC_URL=

# Accepted stablecoins, as a JSON array. Keep the single quotes in this file;
# on Vercel, paste the JSON without them.
# Default: Circle's devnet USDC. scripts/seed-demo.ts prints a line to add.
NEXT_PUBLIC_STABLE_MINTS='[{"mint":"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU","symbol":"USDC","decimals":6,"label":"USDC (devnet)"}]'

# Supabase, server only. The service_role key bypasses RLS: never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string (32+ characters) used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Both modes -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spread of the simulated Pix cash-out, in basis points (50 = 0.50%).
PAYOUT_SPREAD_BPS=50
